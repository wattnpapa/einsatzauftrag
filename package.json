{
  "name": "einsatzauftrag",
  "version": "1.0.0",
  "description": "Füllt den Einsatzauftrag (Fb Fü 3) als PDF aus (jsPDF), das Formular als Vektorgrafik gezeichnet, auf möglichst einer A4-Seite.",
  "keywords": [
    "einsatzauftrag",
    "thw",
    "fuehrung",
    "katastrophenschutz",
    "bos",
    "jspdf",
    "pdf"
  ],
  "homepage": "https://github.com/wattnpapa/einsatzauftrag#readme",
  "bugs": {
    "url": "https://github.com/wattnpapa/einsatzauftrag/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wattnpapa/einsatzauftrag.git"
  },
  "license": "EUPL-1.2",
  "author": {
    "name": "Johannes Rudolph",
    "email": "johannes.rudolph@thw-oldenburg.de"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "beispiel": "npm run build && node scripts/beispiel.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "web": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts"
  },
  "peerDependencies": {
    "jspdf": "^4.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
